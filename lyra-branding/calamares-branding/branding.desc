# Lyra OS — branding do Calamares (PROMPT-LYRA-IDENTIDADE.md §4.5)
# Instalado em /usr/share/calamares/branding/lyra/
# Complementa o branding.desc base descrito em PROMPT-LYRA-OS.md §7

componentName: lyra

welcomeStyleCalamares: false
welcomeExpandingLogo: true

strings:
    productName:         "Lyra OS"
    shortProductName:    "Lyra"
    version:              "rolling"
    shortVersion:          "rolling"
    versionedName:        "Lyra OS"
    shortVersionedName:   "Lyra OS"
    bootloaderEntryName: "Lyra OS"
    productUrl:          "https://lyraos.org"
    supportUrl:          "https://lyraos.org/support/"
    knownIssuesUrl:      "https://lyraos.org/support/"
    releaseNotesUrl:     "https://lyraos.org/docs/"

images:
    productLogo:         "logo.svg"
    productIcon:         "logo.svg"
    # productWallpaper removido de propósito: ele troca o fundo de TODA
    # página do instalador (não só a sidebar) pelo wallpaper escuro, e
    # várias telas (ex.: descrição das opções em Partições) desenham
    # texto secundário com cor fixa no próprio C++ do Calamares — não dá
    # pra sobrescrever via QSS de forma confiável. Sem esta chave, o
    # conteúdo principal usa o fundo claro padrão do Qt (onde o texto
    # escuro nativo já é legível em todo lugar), e só a sidebar
    # (SidebarBackground/SidebarText abaixo) fica com a identidade
    # visual escura da marca.

slideshow:               "show.qml"
slideshowAPI:            2

# Nomes de chave exatos que o Calamares realmente lê (CamelCase) — os
# nomes usados antes (sidebarBackground, sidebarTextSelect,
# sidebarTextHighlight) não existem no schema e eram ignorados em
# silêncio (comparado com o branding.desc padrão do pacote calamares).
style:
   SidebarBackground:        "#0D0D1F"
   SidebarText:              "#E8ECFF"
   SidebarTextCurrent:       "#E8ECFF"
   SidebarBackgroundCurrent: "#8B5CF6"
