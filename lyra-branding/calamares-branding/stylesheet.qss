/* Lyra OS — stylesheet do Calamares (PROMPT-LYRA-IDENTIDADE.md §4.5)
 *
 * branding.desc define productWallpaper como fundo escuro de TODAS as
 * páginas (Welcome, Locale, Partition, Users, Summary, Finished). Sem
 * este arquivo, os QLabel do conteúdo principal ficam com a cor de
 * texto padrão da paleta Qt (escura), invisível sobre esse fundo — foi
 * o que aconteceu com o título "Welcome to the Lyra OS installer".
 *
 * A lista de passos na sidebar (#sidebarApp) usa outro mecanismo -
 * pintura customizada em C++, configurada via style: no branding.desc,
 * não QSS - por isso não precisa de regra aqui.
 */

#mainApp {
    color: #E8ECFF;
}

QLabel {
    color: #E8ECFF;
}
