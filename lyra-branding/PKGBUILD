# Maintainer: Lyra OS <contato@lyraos.org>
#
# lyra-branding — pacote de identidade visual do Lyra OS
# (PROMPT-LYRA-IDENTIDADE.md §5 — Empacotamento)
#
# Instala logo, mascote (Lyro), tema GRUB, tema Plymouth, branding do
# Calamares e configuração do fastfetch. Fonte de verdade dos assets
# vetoriais/paleta é o diretório branding/ na raiz do repositório;
# este PKGBUILD só empacota o que já está pronto — não gera arte.
#
# Empacotamento 100% local (monorepo): não há fontes remotas para
# baixar nem checksums de terceiros, por isso source=() fica vazio e
# package() lê diretamente de $startdir/../branding e dos subdiretórios
# deste pacote (grub-theme/, plymouth-theme/, calamares-branding/, fastfetch/).

pkgname=lyra-branding
pkgver=1.0.0
pkgrel=1
pkgdesc="Identidade visual do Lyra OS — logo, mascote Lyro, temas de boot e branding do instalador"
arch=('any')
url="https://lyraos.org"
license=('custom')
depends=('hicolor-icon-theme')
optdepends=(
    'grub: tema visual do GRUB'
    'plymouth: tema visual de boot'
    'calamares: branding do instalador'
    'fastfetch: banner de terminal com a marca Lyra'
)
makedepends=('grub' 'cantarell-fonts')
options=('!strip')
install=lyra-branding.install
source=()
sha256sums=()

_branding="$startdir/../branding"
_pkgdir_src="$startdir"

check() {
    # Garante que o slogan não foi digitado manualmente em nenhum componente
    # (PROMPT-LYRA-IDENTIDADE.md §2 e §6 — checklist de validação).
    local slogan qml
    slogan="$(tr -d '\n' < "$_branding/slogan/slogan.txt")"
    qml="$_pkgdir_src/calamares-branding/show.qml"
    if ! grep -qi "harmonia. performance. liberdade." "$qml"; then
        echo "ERRO: slogan em show.qml diverge de branding/slogan/slogan.txt: '$slogan'" >&2
        return 1
    fi
}

package() {
    # --- Logo (pixmaps + hicolor) ---
    install -Dm644 "$_branding/logo/lyra-logo.svg" "$pkgdir/usr/share/pixmaps/lyra-logo.svg"
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "$_branding/logo/png/lyra-logo-${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/lyra-logo.png"
    done

    # --- Avatar padrão (Lyro, circular 512x512) ---
    install -Dm644 "$_branding/mascot/lyro-avatar-512.png" "$pkgdir/usr/share/pixmaps/faces/lyro.png"

    # --- Paleta e slogan (fonte única, referenciável por outros componentes) ---
    install -Dm644 "$_branding/palette.json" "$pkgdir/usr/share/lyra/branding/palette.json"
    install -Dm644 "$_branding/slogan/slogan.txt" "$pkgdir/usr/share/lyra/branding/slogan.txt"

    # --- Tema GRUB (§4.2) ---
    local grubdir="$pkgdir/boot/grub/themes/lyra"
    install -Dm644 "$_pkgdir_src/grub-theme/theme.txt" "$grubdir/theme.txt"
    install -Dm644 "$_pkgdir_src/grub-theme/background.png" "$grubdir/background.png"
    install -Dm644 "$_pkgdir_src/grub-theme/wordmark.png" "$grubdir/wordmark.png"
    install -Dm644 "$_pkgdir_src/grub-theme/select_highlight.png" "$grubdir/select_highlight.png"
    # Fonte "Lyra Regular 16" gerada a partir do Cantarell do sistema (§1.2)
    grub-mkfont -o "$grubdir/lyra-regular-16.pf2" -n "Lyra Regular" -s 16 \
        /usr/share/fonts/cantarell/Cantarell-VF.otf 2>/dev/null \
        || grub-mkfont -o "$grubdir/lyra-regular-16.pf2" -n "Lyra Regular" -s 16 \
            /usr/share/fonts/cantarell/Cantarell-Regular.ttf

    # --- Tema Plymouth (§4.3) ---
    local plydir="$pkgdir/usr/share/plymouth/themes/lyra"
    install -Dm644 "$_pkgdir_src/plymouth-theme/lyra.plymouth" "$plydir/lyra.plymouth"
    install -Dm644 "$_pkgdir_src/plymouth-theme/lyra.script" "$plydir/lyra.script"
    for f in lyre-body.png star.png spinner.png box.png lock.png entry.png bullet.png; do
        install -Dm644 "$_pkgdir_src/plymouth-theme/$f" "$plydir/$f"
    done

    # --- Branding do Calamares (§4.5) ---
    local caldir="$pkgdir/usr/share/calamares/branding/lyra"
    install -Dm644 "$_pkgdir_src/calamares-branding/branding.desc" "$caldir/branding.desc"
    install -Dm644 "$_pkgdir_src/calamares-branding/show.qml" "$caldir/show.qml"
    install -Dm644 "$_branding/logo/lyra-logo.svg" "$caldir/logo.svg"
    install -Dm644 "$_pkgdir_src/grub-theme/wordmark.png" "$caldir/wordmark.png"
    install -Dm644 "$_branding/mascot/lyro-transparent.png" "$caldir/lyro.png"
    if [[ -f "$startdir/../lyra-iso/assets/wallpaper/default.png" ]]; then
        install -Dm644 "$startdir/../lyra-iso/assets/wallpaper/default.png" "$caldir/wallpaper.png"
    fi

    # --- fastfetch (§4.8) ---
    install -Dm644 "$_pkgdir_src/fastfetch/config.jsonc" "$pkgdir/etc/fastfetch/config.jsonc"
    install -Dm644 "$_pkgdir_src/fastfetch/lyra-ascii.txt" "$pkgdir/usr/share/fastfetch/lyra-ascii.txt"

    # --- Licença/atribuição ---
    install -Dm644 "$_branding/slogan/slogan.txt" "$pkgdir/usr/share/licenses/$pkgname/slogan.txt"
}
