<?xml version="1.0" encoding="utf-8"?>
<!--
  Lyra OS - Odisseia (desktop) + Lyra OS Server
  KIWI appliance description for the x86_64 live/installer ISO, with two
  profiles sharing one base (official Leap 16 repos + the Lyra OBS repos,
  kernel-default, partitioning/bootloader tooling):

  - "desktop" (default, matches pre-profile behavior): GNOME live session,
    Btrfs/Snapper, the native Lyra Installer (Rust/Tauri GUI),
    Vega(GTK4)/Sheliak/Fina/Beam/Sulafat + a curated GNOME app set +
    Firefox/CUPS/Flatpak.
  - "server": headless, no GNOME/theme/icons, ext4 (no Btrfs/Snapper/
    RAID/LVM in v1), vega-cli + vegad + vega-web instead of vega-gtk, no
    Lyra Installer GUI (console installer in scripts/server-install.sh
    instead). See docs/server-edition.md for the full rationale.

  See kiwi/README.md for the remaining gaps (installer artwork, multimedia
  codecs pending upstream, release automation, and end-to-end testing).
-->
<image schemaversion="8.3" name="lyra-os" displayname="Lyra OS">

  <description type="system">
    <author>Rodrigo Brito</author>
    <contact>rodrigo@w3ti.com.br</contact>
    <specification>Lyra OS "Odisseia" Alpha 4 - live/installer ISO, openSUSE Leap 16 base, GNOME desktop, x86_64</specification>
  </description>

  <profiles>
    <!-- import="true": building with no explicit profile selection keeps
         the exact pre-profile (desktop) behavior, matching every existing
         build script/CI invocation. -->
    <profile name="desktop" description="Lyra OS desktop live/installer ISO" import="true"/>
    <profile name="server" description="Lyra OS Server headless live/installer ISO"/>
  </profiles>

  <preferences>
    <!-- Shared by both profiles. -->
    <packagemanager>zypper</packagemanager>
    <rpm-excludedocs>true</rpm-excludedocs>
    <rpm-check-signatures>true</rpm-check-signatures>
    <!-- The first locale is the live session default; keep en-US first. -->
    <locale>en_US,pt_BR,es_ES</locale>
    <keytable>us</keytable>
    <timezone>UTC</timezone>
  </preferences>

  <preferences profiles="desktop">
    <!-- Generated from release.toml; user-facing strings say "Alpha 4". -->
    <version>2026.08-alpha4</version>
    <!--
      Selects lyra-os-theme's "Lyra-OS" assets. The
      bootloader theme is active in the live GRUB menu. The bootsplash
      selection records the desired default in the image root, but the
      live initrd deliberately excludes Plymouth: adding plymouth-dracut
      makes the non-host-only dracut build pull every generic DRM driver
      and its firmware, producing a 138 MiB initrd that stalls visibly in
      GRUB. See the package-list comment and kiwi/README.md.
    -->
    <bootloader-theme>Lyra-OS</bootloader-theme>
    <bootsplash-theme>Lyra-OS</bootsplash-theme>
    <type
      image="iso"
      primary="true"
      flags="overlay"
      filesystem="squashfs"
      firmware="uefi"
      editbootconfig="edit_boot_config.sh"
      volid="LYRA_OS_2026_08_ALPHA4"
      application_id="LyraOS"
      publisher="Lyra OS Project">
      <bootloader name="grub2" timeout="10"/>
    </type>
  </preferences>

  <preferences profiles="server">
    <!-- Generated from release-server.toml by scripts/server-release.py;
         own alpha/beta/rc/final cycle, does not share release.toml's
         calendar_version with the desktop profile. -->
    <version>2026.08-beta1</version>
    <type
      image="iso"
      primary="true"
      flags="overlay"
      filesystem="squashfs"
      firmware="uefi"
      editbootconfig="edit_boot_config.sh"
      volid="LYRA_OS_SERVER_2026_08_BETA1"
      application_id="LyraOSServer"
      publisher="Lyra OS Project">
      <bootloader name="grub2" timeout="10"/>
    </type>
  </preferences>

  <users>
    <!--
      root is locked in the image itself (build/live concern only), on
      both profiles. The spec's "root disabled, sudo user created at
      install time" is an installer behavior on the installed system, not
      this file. The server profile autologs into a root console via a
      systemd getty override (kiwi/server/etc/systemd/system/getty@tty1.service.d/) -
      locked password does not block that, the same way it does not block
      the desktop's GDM autologin as liveuser below.
    -->
    <user name="root" password="!" pwdformat="encrypted" home="/root" shell="/bin/bash"/>
  </users>

  <users profiles="desktop">
    <!--
      Live-session convenience account with GDM autologin (configured
      in config.sh) so the ISO boots to a usable desktop before an
      installer exists. Locked password, no relation to the installed
      system's user model. The server profile has no graphical session
      and autologs directly into root on the console instead (see above).
    -->
    <user name="liveuser" password="!" pwdformat="encrypted" home="/home/liveuser" shell="/usr/bin/fish" groups="wheel,video,audio"/>
  </users>

  <!--
    Official Leap 16 base repos. The narrowly scoped, desktop-only Packman
    Essentials source and the required Lyra OBS ecosystem follow below.
    Leap 16 deliberately has no separate update repository: official
    maintenance updates are published through repo-oss itself.
  -->
  <repository alias="repo-oss" priority="20" type="rpm-md" imageinclude="true"
              repository_gpgcheck="true" package_gpgcheck="true">
    <source path="https://download.opensuse.org/distribution/leap/16.0/repo/oss/"/>
  </repository>
  <repository alias="repo-non-oss" priority="21" type="rpm-md" imageinclude="true"
              repository_gpgcheck="true" package_gpgcheck="true">
    <source path="https://download.opensuse.org/distribution/leap/16.0/repo/non-oss/"/>
  </repository>

  <!-- Desktop-only proprietary multimedia codecs. Limit the third-party
       surface to Packman Essentials instead of enabling the full repository;
       priority 15 lets its full codec builds win over the restricted official
       variants while Lyra's own build repositories (1-3) remain authoritative. -->
  <repository alias="repo-packman-essentials" priority="15" type="rpm-md"
              imageinclude="true" repository_gpgcheck="true"
              package_gpgcheck="true" profiles="desktop">
    <source path="https://ftp.gwdg.de/pub/linux/misc/packman/suse/openSUSE_Leap_16.0/Essentials/"/>
  </repository>

  <!--
    Lyra ecosystem repos, hosted on OBS under the `rodrigosbrito` account
    (see PROMPT-LYRA-OS.md). Verified live against the real OBS instance
    on 2026-08-05 (build target "openSUSE_Leap_16.0" on all three,
    repodata resolves, and vega-gtk/sheliak/fina/lyra-theme's subpackages
    all build successfully):
      https://download.opensuse.org/repositories/home:/rodrigosbrito:/{lyra,vega,fina}/openSUSE_Leap_16.0/

    Priorities below (1-3) are deliberately lower than repo-oss/repo-non-oss
    (20-21) above - in zypper, lower number wins. These repos ship forked
    versions of packages that can also exist upstream. The installer resets
    all three OBS repos to priority 90 in the installed system. The broad
    override is therefore limited to image construction; normal updates
    continue to prefer official Leap packages (priorities 20-21) when a
    same-name package exists.
  -->
  <repository alias="repo-lyra" priority="1" type="rpm-md" imageinclude="true"
              repository_gpgcheck="true" package_gpgcheck="true">
    <source path="https://download.opensuse.org/repositories/home:/rodrigosbrito:/lyra/openSUSE_Leap_16.0/"/>
  </repository>
  <repository alias="repo-vega" priority="2" type="rpm-md" imageinclude="true"
              repository_gpgcheck="true" package_gpgcheck="true">
    <source path="https://download.opensuse.org/repositories/home:/rodrigosbrito:/vega/openSUSE_Leap_16.0/"/>
  </repository>
  <!-- Fina is desktop-only (see docs/server-edition.md); scoping the repo
       itself, not just the package, keeps the server profile from pulling
       in a source it never installs from. -->
  <repository alias="repo-fina" priority="3" type="rpm-md" imageinclude="true"
              repository_gpgcheck="true" package_gpgcheck="true" profiles="desktop">
    <source path="https://download.opensuse.org/repositories/home:/rodrigosbrito:/fina/openSUSE_Leap_16.0/"/>
  </repository>

  <!-- Pacotes gerais publicados no projeto OBS pessoal do mantenedor que
       complementam o desktop, sem substituir os projetos dedicados acima.
       A prioridade 90 preserva a preferência pelos repositórios oficiais do
       Leap durante atualizações normais. O Server não consome esta origem. -->
  <repository alias="repo-rodrigosbrito" priority="90" type="rpm-md"
              imageinclude="true" repository_gpgcheck="true"
              package_gpgcheck="true" profiles="desktop">
    <source path="https://download.opensuse.org/repositories/home:/rodrigosbrito/openSUSE_Leap_16.0/"/>
  </repository>

  <packages type="bootstrap">
    <package name="ca-certificates"/>
    <package name="ca-certificates-mozilla"/>
    <package name="filesystem"/>
    <package name="glibc-locale"/>
    <package name="Leap-release"/>
  </packages>

  <packages type="image" patternType="onlyRequired">
    <!--
      onlyRequired: pull in each pattern's Requires only, not its long
      Recommends lists (checked against the real patterns-gnome.spec
      from OBS - gnome_basic/gnome's Recommends include things like
      evolution, pidgin, planner, remmina, gnome-initial-setup, and
      opensuse-welcome-launcher, none of which fit "curated" or the
      spec's "no onboarding" rule). Everything actually wanted is added
      back explicitly below instead of trying to block-list from a much
      larger default set.

      This first (profile-less) block is shared by desktop and server:
      base Leap system, kernel, bootloader/Secure Boot tooling, and the
      partitioning/filesystem/network tools both installers need.
    -->

    <!-- Base system -->
    <namedCollection name="base"/>
    <namedCollection name="enhanced_base"/>
    <package name="kernel-default"/>
    <!-- Keep the live dracut module in the image package set, matching the
         official openSUSE live recipe. OBS then stages its RPM for KIWI and
         the module remains available to both live boot and the installer. -->
    <package name="dracut-kiwi-live"/>
    <!-- kernel-default only Recommends firmware; onlyRequired would produce
         an ISO that boots in the VM but loses Wi-Fi/GPU/storage support on
         common physical hardware. CPU microcode is likewise explicit. -->
    <package name="kernel-firmware-all"/>
    <package name="ucode-amd"/>
    <package name="ucode-intel"/>
    <package name="grub2"/>
    <package name="grub2-x86_64-efi"/>
    <!-- shim + mokutil: Secure Boot is in scope for both installers (see
         docs/server-edition.md - the server profile does not treat it as
         a v2 trade-off). -->
    <package name="shim"/>
    <package name="mokutil"/>
    <!-- Neither is pulled in as a hard Requires under onlyRequired, but
         dracut's network module (needed by kiwi-live for the live boot)
         hard-requires the `ip` and `curl` binaries. -->
    <package name="iproute2"/>
    <package name="curl"/>
    <!-- Used by the local-only, on-demand /usr/bin/lyra-report archive. -->
    <package name="tar"/>
    <package name="gzip"/>
    <package name="python3-base"/>
    <package name="pciutils"/>
    <package name="usbutils"/>
    <package name="less"/>
    <!-- Command-line documentation is a baseline administration facility on
         both Desktop and Server; onlyRequired does not guarantee it. -->
    <package name="man"/>
    <!-- Keep familiar modal and approachable terminal editors in both
         Desktop and Server for recovery and offline administration. -->
    <package name="vim"/>
    <package name="neovim"/>
    <package name="nano"/>

    <!-- Opt-in local performance capture and aggregation (issue #49). -->
    <package name="procps"/>

    <!--
      Required for the "root disabled, sudo user created at install"
      model (PROMPT-LYRA-OS.md) to work on the installed system, on both
      profiles. The desktop's Rust installer writes /etc/sudoers.d/10-installer
      on the target; the server's scripts/server-install.sh does the
      equivalent. Without this package the directory is absent. The image
      doubles as the target rootfs, so sudo is also present in the live
      session even though liveuser's password is locked and never used
      there.
    -->
    <package name="sudo"/>

    <!-- Provides chattr (desktop's Btrfs nodatacow workaround) and mke2fs
         (the server profile's ext4 root filesystem - see
         docs/server-edition.md). Needed by both profiles for different
         reasons. -->
    <package name="e2fsprogs"/>
    <!-- Both installers create a FAT32 EFI System Partition and deploy the
         live squashfs into the target. These tools are runtime
         requirements, not merely image-build utilities. -->
    <package name="dosfstools"/>
    <package name="squashfs"/>
    <!-- sgdisk currently arrives transitively, but both installers invoke it
         directly, so keep its provider explicit under onlyRequired. -->
    <package name="gptfdisk"/>
    <!-- mount/blkid/mkswap and friends; mkswap is used when the desktop's
         guided installer selects disk-backed swap. -->
    <package name="util-linux"/>

    <!-- ZRAM remains the default swap mechanism for both profiles; it
         activates its own systemd generator at boot with no service to
         enable (see kiwi/config.sh). The desktop's guided installer can
         remove this configuration for disk-backed swap or a no-swap
         installation; the server profile has no such prompt in v1. -->
    <package name="zram-generator"/>

    <!-- Leap defaults, listed explicitly so a minimal bootstrap doesn't
         drop them. Both profiles need networking; firewalld's default
         policy differs per profile (kiwi/config.sh), not the package set. -->
    <package name="NetworkManager"/>
    <package name="firewalld"/>
  </packages>

  <packages type="image" patternType="onlyRequired" profiles="desktop">
    <!--
      Filesystem / snapshots. Btrfs itself stays the Leap default; the
      Snapper config on the installed system is bootstrapped by the Rust
      installer since there is no YaST/Agama here to do it automatically.
      grub2-snapper-plugin provides /etc/grub.d/80_suse_btrfs_snapshot,
      which SUSE_BTRFS_SNAPSHOT_BOOTING (grubcfg.conf) turns on - this
      is what makes the GRUB panic-button rollback menu exist at all.
      Server profile uses plain ext4 instead (docs/server-edition.md).
    -->
    <package name="btrfsprogs"/>
    <package name="snapper"/>
    <!-- snapper only Recommends this package; onlyRequired would otherwise
         omit the plugin that creates pre/post snapshots for zypper. -->
    <package name="snapper-zypp-plugin"/>
    <package name="grub2-snapper-plugin"/>

    <!--
      RAID (mdadm) and LVM (pvs/vgs/lvs/vgcreate/lvcreate) support for the
      Rust installer's storage discovery/plan module (issue #39). RAID
      arrays already assembled by the kernel/initrd are detected via sysfs
      alone, but LVM has no sysfs-only equivalent - without lvm2 installed,
      volume groups/logical volumes are simply invisible to discovery, and
      neither tool exists yet for the plan-execution step (#40) to actually
      create an array or a VG. Server profile's installer v1 is single-disk
      only, no RAID/LVM (docs/server-edition.md).
    -->
    <package name="mdadm"/>
    <package name="lvm2"/>

    <package name="pipewire"/>
    <package name="pipewire-pulseaudio"/>
    <package name="wireplumber"/>
    <!-- Kept as a runtime/theme-package dependency. Do not add
         plymouth-dracut here: its drm dependency inflates the generic live
         initrd and caused the boot regression at "Loading initial ramdisk". -->
    <package name="plymouth"/>

    <!--
      Bluetooth. Not pulled in by gnome_basic/gnome's Requires chain under
      onlyRequired - confirmed missing on a real installed image (rpm -q
      bluez: "package bluez is not installed"), which is why Bluetooth
      never turned on. bluez is the actual stack/daemon (bluetooth.service,
      enabled in config.sh); gnome-bluetooth is GNOME Settings' Bluetooth
      panel integration (libgnome-bluetooth itself already arrives
      transitively, but not this package); bluez-firmware covers common
      built-in adapters that need a firmware upload before they work.
    -->
    <package name="bluez"/>
    <package name="bluez-firmware"/>
    <package name="gnome-bluetooth"/>

    <!--
      GStreamer plugins for GNOME Shell's built-in screen recorder
      (Ctrl+Shift+Alt+R) - it encodes to VP8/WebM via gstreamer's vp8enc,
      which lives in gstreamer-plugins-good, not gstreamer-plugins-base
      (already present transitively). Without it, screenshots work
      (a separate, non-GStreamer code path) but recording silently fails.
      Confirmed missing on a real installed image the same way as bluez
      above.
    -->
    <package name="gstreamer-plugins-good"/>

    <!-- The Rust installer's privileged service is authorized separately;
         the graphical process continues to run as liveuser. -->
    <package name="polkit"/>

    <!--
      GNOME desktop. gnome_basic+gnome's Requires chain brings in GDM,
      GNOME Session, Seahorse, accessibility infrastructure and base fonts.
      Important desktop integration packages which are only Recommends in
      Leap are explicit below because this image uses onlyRequired.
    -->
    <namedCollection name="gnome_basic"/>
    <namedCollection name="gnome"/>
    <!-- WebKitGTK does not synthesize flag glyphs from the base DejaVu fonts.
         Keep Noto Color Emoji explicit because the installer language picker
         uses regional-indicator emoji for its language flags. -->
    <package name="google-noto-coloremoji-fonts"/>
    <!-- Leap 16 does not provide fetchmsttfonts or redistributable Microsoft
         Core Fonts RPMs. Ship the repository-native TrueType metric
         substitutes instead: Liberation covers Arial/Times New Roman/Courier
         New documents and Carlito covers Calibri-compatible documents. -->
    <package name="liberation-fonts"/>
    <package name="google-carlito-fonts"/>
    <package name="google-noto-sans-cjk-fonts"/>
    <!-- GNOME Shell obtains battery presence, charge and AC state through
         UPower. It is only a recommendation in the minimal Leap dependency
         graph, so onlyRequired omitted the daemon while retaining its client
         library; the result was a working BAT1 in sysfs but no battery icon. -->
    <package name="upower"/>
    <package name="nautilus"/>
    <!-- Nautilus only Recommends gvfs. Without these explicit packages,
         trash, removable media, phones and network locations are missing. -->
    <package name="gvfs"/>
    <package name="gvfs-backends"/>
    <package name="gvfs-fuse"/>
    <package name="udisks2"/>
    <package name="gnome-keyring-pam"/>
    <package name="polkit-default-privs"/>
    <package name="xdg-user-dirs-gtk"/>
    <!-- Required for Flatpak file pickers, screenshots and other desktop
         portals; GNOME only recommends it through the full pattern set. -->
    <package name="xdg-desktop-portal-gnome"/>

    <!--
      Curated app set (checklist: "manter o essencial: Arquivos, Textos,
      Configuracoes, Camera, etc." + explicit spec requirements). Picked
      by reading patterns-gnome.spec's actual Recommends lists on OBS
      and choosing what earns a place, not by trimming everything down
      to the bare Requires chain above and stopping there.

      Deliberately NOT included (redundant/rare/onboarding-flavored,
      confirmed present as Recommends in patterns-gnome.spec so they'd
      otherwise sneak in under plusRecommended): gnome-maps,
      gnome-weather, gnome-contacts, evolution(-ews), pidgin, planner,
      remmina, vinagre, gnome-music, totem, gnome-initial-setup,
      opensuse-welcome-launcher (this last pair specifically because the
      spec rules out any first-boot onboarding).
    -->
    <package name="gnome-control-center"/>
    <package name="gnome-text-editor"/>
    <!-- Cheese was renamed/rewritten upstream; there is no "cheese" RPM
         in Leap 16 - verified against the real repodata. -->
    <package name="snapshot"/>
    <!-- GNOME Terminal remains the default, while the newer GNOME Console is
         also available as a deliberately selected alternative. GNOME 48's
         terminal gsettings schema already names gnome-terminal by default. -->
    <package name="gnome-terminal"/>
    <package name="gnome-console"/>
    <!-- Fish will be the interactive shell in the next Lyra OS Desktop
         release. Keep it desktop-only; changing the user account's default
         shell is handled separately by the installer. -->
    <package name="fish"/>
    <!-- The POSIX nvm.sh implementation does not support Fish. Lyra packages
         the native, versioned nvm.fish integration in repo-lyra so Node
         versions remain per-user without a first-login plugin download. -->
    <package name="nvm-fish"/>
    <!-- Required by nvm-fish and LinuxToys. Keep it explicit so a minimal
         solver result cannot leave the default shell integration broken. -->
    <package name="git"/>
    <!-- Packaged by Lyra from a fixed upstream release. Its curl-pipe-shell
         self-updater is disabled downstream; RPM/Zypper owns updates. -->
    <package name="linuxtoys"/>
    <!-- Shown once per installed user through its guarded XDG autostart.
         The launcher explicitly skips the liveuser installation session. -->
    <package name="lyra-welcome"/>
    <package name="gnome-calculator"/>
    <package name="gnome-characters"/>
    <package name="gnome-disk-utility"/>
    <!-- gnome-papers isn't packaged for Leap 16 yet - evince is what's
         actually in the repo, also verified. -->
    <package name="evince"/>
    <package name="loupe"/>
    <package name="baobab"/>
    <package name="gnome-logs"/>
    <package name="gnome-tweaks"/>
    <!-- Accessibility - kept deliberately; curation is about redundant
         apps, not accessibility tooling. -->
    <package name="orca"/>
    <!-- Firefox: default browser. Confirmed as `MozillaFirefox` in the
         real Leap 16.0 OSS repodata (there is no plain "firefox" RPM).
         Leap does not publish one Firefox RPM per locale: the version-locked
         translations-common package provides es_ES and pt_BR (among others),
         while en_US is built into the main package. That covers all three
         installer locales; translations-other contains none of them and
         is deliberately omitted. Do not force
         intl.locale.requested in policies.json: Firefox must follow LANG,
         which the installer writes from the selected system locale. -->
    <package name="MozillaFirefox"/>
    <package name="MozillaFirefox-translations-common"/>

    <!-- Thunderbird ESR from the official Leap 16 Backports repository.
         Like Firefox, its en_US strings are built into the main package;
         translations-common contains both es_ES and pt_BR. Thunderbird then
         follows the LANG written by the installer, so no application-specific
         locale preference is forced. translations-other is unnecessary for
         the three locales supported by this release. -->
    <package name="MozillaThunderbird"/>
    <package name="MozillaThunderbird-translations-common"/>

    <!-- LibreOffice: the framework does not require its application modules,
         and onlyRequired drops recommended locale packs. Keep the desktop
         modules, GNOME integration and every installer-supported locale
         explicit so the installed suite follows LANG selected by the user. -->
    <package name="libreoffice"/>
    <package name="libreoffice-base"/>
    <package name="libreoffice-calc"/>
    <package name="libreoffice-draw"/>
    <package name="libreoffice-impress"/>
    <package name="libreoffice-math"/>
    <package name="libreoffice-writer"/>
    <package name="libreoffice-gnome"/>
    <package name="libreoffice-gtk3"/>
    <package name="libreoffice-l10n-en"/>
    <package name="libreoffice-l10n-pt_BR"/>
    <package name="libreoffice-l10n-es"/>

    <!-- VLC and the complete FFmpeg/GStreamer codec stack. The codec packages
         come from the desktop-only Packman Essentials repository above. -->
    <package name="vlc"/>
    <package name="vlc-codecs"/>
    <package name="ffmpeg-7"/>
    <package name="gstreamer-plugins-bad-codecs"/>
    <package name="gstreamer-plugins-ugly-codecs"/>

    <!-- Redistributable firmware from the official Non-OSS channel. Generic
         kernel firmware remains covered by kernel-firmware-all above. -->
    <package name="ivtv-firmware"/>
    <package name="bladeRF-fpga-firmware"/>
    <package name="bladeRF-fx3-firmware"/>

    <!-- CUPS + common drivers, printing and scanning. -->
    <package name="cups"/>
    <package name="cups-filters"/>
    <package name="system-config-printer"/>
    <package name="gutenprint"/>
    <package name="sane-backends"/>
    <package name="sane-airscan"/>
    <package name="simple-scan"/>

    <!--
      Flatpak itself; the Flathub remote is registered at build time in
      config.sh (needs network access during the KIWI build - see
      README.md). No Flatpak apps are pre-installed here.
    -->
    <package name="flatpak"/>

    <!--
      Vega (GTK4 frontend). Package name confirmed against
      home:rodrigosbrito:vega's real OBS package list (vega-gtk,
      alongside vega-cli/vegad which aren't pulled in explicitly - RPM
      deps will bring in whatever vega-gtk actually needs). The server
      profile installs vega-cli/vegad/vega-web directly instead, see
      below.
    -->
    <package name="vega-gtk"/>

    <!-- Lyra's native remote-access clients, pinned in the default GNOME
         favorites together with Vega and Firefox. -->
    <package name="beam"/>
    <package name="sulafat"/>

    <!--
      Sheliak, Lyra's GNOME 48 dock. Installing a system extension alone
      does not enable it for users, so the image also ships a GNOME Shell
      schema override under root/usr/share/glib-2.0/schemas/.
    -->
    <package name="sheliak"/>

    <!-- Fina, from the dedicated home:rodrigosbrito:fina OBS repository.
         Desktop-only (docs/server-edition.md). -->
    <package name="fina"/>

    <!--
      Lyra Installer, the native Rust/Tauri installer and the only installer
      in the Beta 2 live session. Its RPM ships the GUI, privileged service,
      desktop entry, polkit policy and lock wrapper. The overlay pins the
      wrapper, launcher and icon so repository publication lag cannot break
      the GDM autostart or branding; tests require those copies to remain
      byte-identical to their package sources. The server profile has no
      GNOME session to launch this from; it uses
      scripts/server-install.sh in console instead.
    -->
    <package name="lyra-installer"/>

    <!--
      Branding (Lyra-Theme, github.com/britors/Lyra-Theme). Package
      names, dependency, and behavior confirmed against that repo's real
      packaging/opensuse/*.spec and install-rpm.sh, not assumed:

      - lyra-os-theme's %post already sets GRUB_THEME in
        /etc/default/grub + runs grub2-mkconfig, and selects the
        Lyra-OS Plymouth theme. The live initrd intentionally omits
        plymouth-dracut; only the GRUB theme is enabled on the live path.
      - It also ships a compiled-in gsettings default
        (/usr/share/glib-2.0/schemas/99-lyra-os.gschema.override:
        icon-theme, accent-color, color-scheme=prefer-dark, both
        picture-uri/picture-uri-dark wallpapers) - this is what actually
        satisfies "dark and light both installed, one active by
        default" from the spec, with no extra dconf work needed here.
        Dark is the package's own hardcoded default; nothing in the spec
        picks one for v1, and the dark palette is the one described in
        more detail there, so accepting the package default was the
        reasonable call rather than fighting it.
      - Its %post also installs the GDM dconf defaults and branded logo.
      - Lyra's own 99-lyra-desktop-defaults.gschema.override enables the
        minimize/maximize titlebar buttons and keeps directories before files
        in Nautilus/GTK file views. These are defaults, not locked settings.
      - Requires lyra-os-icons + plymouth-plugin-two-step
        automatically (RPM deps); fastfetch is only a Recommends in the
        spec file so it's made explicit here. Neofetch is left out
        deliberately (Suggests-only upstream, and it's an archived/EOL
        project - fastfetch is the maintained one and is what the theme
        package's own README leads with).
    -->
    <package name="lyra-os-theme"/>
    <package name="lyra-os-icons"/>
    <package name="fastfetch"/>

    <!--
      Translations: Leap packages ship UI strings in a separate
      "<name>-lang" subpackage, pulled in only as a Recommends - which
      onlyRequired (see above) drops just like everything else, so the
      built image ends up with the configured locale set (<locale> above)
      but almost every GNOME app and gnome-shell itself still in English.
      This list was cross-checked against a running reference image
      (`rpm -qa`/`zypper se '*-lang'`) for the desktop-facing packages
      above and the gnome_basic/gnome pattern's GDM/GNOME Session/Seahorse/
