  <packages type="image" patternType="onlyRequired" profiles="server">
    <!--
      Vega's headless components, all from the same
      home:rodrigosbrito:vega OBS project as vega-gtk (repo-vega,
      already declared above - no new repository needed). vega-web is
      the admin interface for this profile (docs/server-edition.md);
      it listens on 9090/tcp, opened by scripts/server-install.sh on the
      installed target (firewall-offline-cmd in the chroot step, not here -
      this file only affects the live image).
    -->
    <package name="vega-cli"/>
    <package name="vegad"/>
    <package name="vega-web"/>

    <!-- SSH is the only other port opened by default (alongside
         vega-web/9090) per docs/server-edition.md; the package providing
         sshd in Leap is "openssh". -->
    <package name="openssh"/>

    <!-- scripts/server-install.sh's TUI. kbd is explicit because the
         installer enumerates every console keymap shipped by that package;
         this must not depend on an indirect base-pattern dependency.
         onlyRequired under gptfdisk
         (common block) does not pull in partprobe either - that binary is
         provided by parted, not gptfdisk or util-linux, confirmed against
         this repo's own dev machine (`rpm -ql parted | grep partprobe`)
         after a real VM install run hit "partprobe: command not found". -->
    <package name="dialog"/>
    <package name="kbd"/>
    <package name="parted"/>

  </packages>

