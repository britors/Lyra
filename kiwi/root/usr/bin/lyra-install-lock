#!/bin/bash
# Lyra OS - Odisseia (v1)
# Prevent two Lyra Installer instances from running at the same time.

set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ ! -d "$runtime_dir" ] || [ ! -w "$runtime_dir" ]; then
    echo "lyra-install-lock: runtime directory is unavailable: $runtime_dir" >&2
    exit 1
fi

lock_file="$runtime_dir/lyra-installer.lock"
exec {lock_fd}>"$lock_file"

if ! flock -n "$lock_fd"; then
    notify-send --icon=drive-harddisk \
        "Instalador já em execução" \
        "Feche a outra janela do instalador antes de abrir esta." \
        2>/dev/null || true
    echo "lyra-install-lock: another installer already holds $lock_file" >&2
    exit 1
fi

exec "$@"
