// Lyra OS - Odisseia (v1)
//
// Lets the live session's autologin account (liveuser, locked password -
// see kiwi/config.sh) launch Calamares without a polkit auth prompt it
// could never satisfy. Grants exactly the one action Calamares' own
// upstream policy defines, and only to that user:
// https://github.com/calamares/calamares/blob/calamares/com.github.calamares.calamares.policy
//
// This has no bearing on the installed system: liveuser only exists in
// the live squashfs, and this rules file lives on the same live media.
polkit.addRule(function(action, subject) {
    if (action.id == "com.github.calamares.calamares.pkexec.run" &&
        subject.user == "liveuser") {
        return polkit.Result.YES;
    }
});
