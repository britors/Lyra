# Maintainer: Lyra OS <contato@lyraos.org>
#
# calamares-lyra-winmigrate — módulo Calamares de migração assistida do
# Windows (PROMPT-CALAMARES-MIGRACAO-WINDOWS.md)
#
# Instala dois módulos Calamares completos (module.desc + implementação
# sob /usr/lib/calamares/modules/<nome>/, como o Calamares exige):
#   winmigrate-detect  job python — varredura/montagem NTFS, cálculo de tamanho
#   winmigrate-copy    job python — cópia via rsync + conversão de favoritos
# e a tela "winmigrate", que NÃO é um módulo próprio — o Calamares não
# tem interface "qml" para módulos "view" (toda view exige um plugin C++
# compilado). Em vez disso, reaproveita o módulo notesqml (qtplugin, já
# incluso no pacote calamares) como host genérico de QML externo: o
# main.qml vai para a pasta de branding do Calamares
# (/usr/share/calamares/branding/lyra/, propriedade do lyra-branding), e
# winmigrate.conf configura a instância "notesqml@winmigrate" declarada
# em settings.conf.
#
# Empacotamento 100% local (monorepo): sem fontes remotas.

pkgname=calamares-lyra-winmigrate
pkgver=1.0.0
pkgrel=1
pkgdesc="Módulo Calamares de migração assistida de arquivos do Windows para o Lyra OS"
arch=('any')
url="https://lyraos.org"
license=('custom')
depends=('calamares' 'lyra-branding' 'python-yaml' 'rsync' 'ntfs-3g' 'util-linux')
options=('!strip')
source=()
sha256sums=()

_src="$startdir"

check() {
    for testfile in "$_src"/tests/*.test.py; do
        python3 "$testfile" -v
    done
}

package() {
    # Módulos completos (module.desc + implementação) vivem em
    # /usr/lib/calamares/modules/<nome>/ — é onde a keyword "local" de
    # modules-search em settings.conf realmente procura (LIBDIR).
    # /usr/share/calamares/modules/ é só para arquivos <nome>.conf de
    # configuração dos módulos, não para o módulo inteiro.

    # --- winmigrate-detect (job) ---
    local detectdir="$pkgdir/usr/lib/calamares/modules/winmigrate-detect"
    install -Dm644 "$_src/winmigrate-detect/module.desc" "$detectdir/module.desc"
    install -Dm644 "$_src/winmigrate-detect/main.py" "$detectdir/main.py"
    install -Dm644 "$_src/winmigrate-detect/detection.py" "$detectdir/detection.py"

    # --- winmigrate (tela, hospedada pelo notesqml — ver comentário acima) ---
    install -Dm644 "$_src/winmigrate/main.qml" \
        "$pkgdir/usr/share/calamares/branding/lyra/winmigrate.qml"
    install -Dm644 "$_src/winmigrate.conf" "$pkgdir/etc/calamares/modules/winmigrate.conf"

    # --- winmigrate-copy (job) ---
    local copydir="$pkgdir/usr/lib/calamares/modules/winmigrate-copy"
    install -Dm644 "$_src/winmigrate-copy/module.desc" "$copydir/module.desc"
    install -Dm644 "$_src/winmigrate-copy/main.py" "$copydir/main.py"
    install -Dm644 "$_src/winmigrate-copy/jobs/__init__.py" "$copydir/jobs/__init__.py"
    install -Dm644 "$_src/winmigrate-copy/jobs/copy_job.py" "$copydir/jobs/copy_job.py"

    # --- Configuração compartilhada (§4) ---
    install -Dm644 "$_src/winmigrate-mapping.conf" "$pkgdir/etc/calamares/modules/winmigrate-mapping.conf"

    # --- Sequência do instalador (§2) ---
    install -Dm644 "$_src/settings.conf" "$pkgdir/etc/calamares/settings.conf"
}
