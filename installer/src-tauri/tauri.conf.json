{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyra Installer",
  "version": "0.1.0",
  "identifier": "org.lyraos.LyraInstaller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "enableGTKAppId": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Instalar o Lyra OS",
        "width": 1180,
        "height": 880,
        "minWidth": 640,
        "minHeight": 440,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "shortDescription": "Instalador nativo do Lyra OS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ]
  }
}
